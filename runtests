#!/bin/bash
# Run CI coverage configurations or a validated focused test.
set -e

if (( $# )); then
    exec python ./runtests.py --focused "$@"
fi

coverage erase
SAMPLE_APP=1 coverage run ./runtests.py --parallel --exclude-tag=selenium_tests
coverage run ./runtests.py --parallel || coverage run ./runtests.py
coverage combine
coverage xml
